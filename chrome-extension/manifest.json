{
  "manifest_version": 3,
  "name": "MT TECH Publisher",
  "version": "0.7.0",
  "description": "Pubblicazione automatica annunci MT TECH su Subito.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://www.subito.it/*",
    "https://inserimento.subito.it/*",
    "https://*.supabase.co/*",
    "https://areariservata.subito.it/*",
    "https://www.vinted.it/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.subito.it/*",
        "https://inserimento.subito.it/*",
        "https://areariservata.subito.it/*"
      ],
      "js": [
        "subito.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.vinted.it/*"
      ],
      "js": [
        "vinted.js"
      ],
      "run_at": "document_idle"
    }
  ]
}